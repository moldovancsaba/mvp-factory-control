// next-auth (Prisma adapter) models
//> P: Data model definition.
model User {
  //> P: Schema field or clause.
  id            String    @id @default(cuid())
  //> P: Schema field or clause.
  name          String?
  //> P: Schema field or clause.
  email         String?   @unique
  //> P: Schema field or clause.
  emailVerified DateTime?
  //> P: Schema field or clause.
  image         String?

  //> P: Schema field or clause.
  accounts Account[]
  //> P: Schema field or clause.
  sessions Session[]

  //> P: Schema field or clause.
  createdAt DateTime @default(now())
  //> P: Schema field or clause.
  updatedAt DateTime @updatedAt

  //> P: Schema field or clause.
  messages ChatMessage[]
  //> P: Schema field or clause.
  threadsCreated ChatThread[] @relation("ThreadCreatedBy")

  //> P: Schema field or clause.
  tasksCreated AgentTask[]
  //> P: Schema field or clause.
  alphaContextWindowsCreated AlphaContextWindow[] @relation("AlphaContextWindowCreatedBy")
  //> P: Schema field or clause.
  alphaContextPackageInvariantsCreated AlphaContextPackageInvariant[] @relation("AlphaContextPackageInvariantCreatedBy")
  //> P: Schema field or clause.
  memoryProfiles MemoryUserProfile[]
  //> P: Schema field or clause.
  memorySourcesCreated MemorySource[] @relation("MemorySourceCreatedBy")
  //> P: Schema field or clause.
  memoryRecordsAuthored MemoryRecord[] @relation("MemoryRecordAuthoredBy")
  //> P: Schema field or clause.
  memoryRecordsReviewed MemoryRecord[] @relation("MemoryRecordReviewedBy")
  //> P: Schema field or clause.
  memoryEventsAuthored MemoryEvent[] @relation("MemoryEventAuthoredBy")
//> P: Block delimiter.
}

//> P: Data model definition.
model Account {
  //> P: Schema field or clause.
  id                String  @id @default(cuid())
  //> P: Schema field or clause.
  userId            String
  //> P: Schema field or clause.
  type              String
  //> P: Schema field or clause.
  provider          String
  //> P: Schema field or clause.
  providerAccountId String
  //> P: Schema field or clause.
  refresh_token     String?
  //> P: Schema field or clause.
  access_token      String?
  //> P: Schema field or clause.
  expires_at        Int?
  //> P: Schema field or clause.
  token_type        String?
  //> P: Schema field or clause.
  scope             String?
  //> P: Schema field or clause.
  id_token          String?
  //> P: Schema field or clause.
  session_state     String?

  //> P: Schema field or clause.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  //> P: Prisma attribute.
  @@unique([provider, providerAccountId])
//> P: Block delimiter.
}

//> P: Data model definition.
model Session {
  //> P: Schema field or clause.
  id           String   @id @default(cuid())
  //> P: Schema field or clause.
  sessionToken String   @unique
  //> P: Schema field or clause.
  userId       String
  //> P: Schema field or clause.
  expires      DateTime

  //> P: Schema field or clause.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
//> P: Block delimiter.
}

//> P: Data model definition.
model VerificationToken {
  //> P: Schema field or clause.
  identifier String
  //> P: Schema field or clause.
  token      String   @unique
  //> P: Schema field or clause.
  expires    DateTime

  //> P: Prisma attribute.
  @@unique([identifier, token])
//> P: Block delimiter.
}

// War Room domain models
//> P: Data model definition.
model Agent {
  //> P: Schema field or clause.
  id           String      @id @default(cuid())
  //> P: Schema field or clause.
  key          String      @unique
  //> P: Schema field or clause.
  displayName  String
  //> P: Schema field or clause.
  avatarUrl    String?
  //> P: Schema field or clause.
  runtime      AgentRuntime @default(MANUAL)
  //> P: Schema field or clause.
  readiness    AgentReadiness @default(NOT_READY)
  //> P: Schema field or clause.
  controlRole  AgentControlRole @default(BETA)
  //> P: Data model definition.
  model        String?
  //> P: Schema field or clause.
  host         String?
  //> P: Schema field or clause.
  enabled      Boolean     @default(true)
  //> P: Schema field or clause.
  capabilities Json?
  //> P: Schema field or clause.
  lastHeartbeatAt DateTime?
  //> P: Schema field or clause.
  lastHeartbeatMeta Json?
  //> P: Schema field or clause.
  smokeTestPassedAt DateTime?
  //> P: Schema field or clause.
  createdAt    DateTime    @default(now())
  //> P: Schema field or clause.
  updatedAt    DateTime    @updatedAt

  //> P: Schema field or clause.
  tasks AgentTask[]
  //> P: Schema field or clause.
  alphaContextWindows AlphaContextWindow[]
  //> P: Schema field or clause.
  activeProjectLocks ProjectAlphaLock[] @relation("ProjectAlphaLockOwner")
//> P: Block delimiter.
}

//> P: Data model definition.
model ChatThread {
  //> P: Schema field or clause.
  id          String     @id @default(cuid())
  //> P: Schema field or clause.
  kind        ThreadKind
  //> P: Schema field or clause.
  ref         String
  //> P: Schema field or clause.
  title       String?
  //> P: Schema field or clause.
  createdById String?
  //> P: Schema field or clause.
  createdAt   DateTime   @default(now())
  //> P: Schema field or clause.
  updatedAt   DateTime   @updatedAt

  //> P: Schema field or clause.
  createdBy User? @relation("ThreadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  //> P: Schema field or clause.
  messages  ChatMessage[]

  //> P: Schema field or clause.
  tasks AgentTask[]

  //> P: Prisma attribute.
  @@unique([kind, ref])
//> P: Block delimiter.
}

//> P: Data model definition.
model ChatMessage {
  //> P: Schema field or clause.
  id         String            @id @default(cuid())
  //> P: Schema field or clause.
  threadId   String
  //> P: Schema field or clause.
  authorType MessageAuthorType
  //> P: Schema field or clause.
  authorKey  String?
  //> P: Schema field or clause.
  userId     String?
  //> P: Schema field or clause.
  content    String
  //> P: Schema field or clause.
  meta       Json?
  //> P: Schema field or clause.
  createdAt  DateTime          @default(now())

  //> P: Schema field or clause.
  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  //> P: Schema field or clause.
  user   User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  //> P: Prisma attribute.
  @@index([threadId, createdAt])
//> P: Block delimiter.
}

//> P: Data model definition.
model AgentTask {
  //> P: Schema field or clause.
  id          String     @id @default(cuid())
  //> P: Schema field or clause.
  status      TaskStatus @default(QUEUED)
  //> P: Schema field or clause.
  agentKey    String
  //> P: Schema field or clause.
  attemptCount Int       @default(0)
  //> P: Schema field or clause.
  maxAttempts  Int       @default(3)
  //> P: Schema field or clause.
  nextAttemptAt DateTime @default(now())
  //> P: Schema field or clause.
  lastFailureCode String?
  //> P: Schema field or clause.
  lastFailureKind String?
  //> P: Schema field or clause.
  deadLetteredAt DateTime?
  //> P: Schema field or clause.
  issueNumber Int?
  //> P: Schema field or clause.
  threadId    String?
  //> P: Schema field or clause.
  title       String
  //> P: Schema field or clause.
  payload     Json?
  //> P: Schema field or clause.
  createdById String?
  //> P: Schema field or clause.
  startedAt   DateTime?
  //> P: Schema field or clause.
  finishedAt  DateTime?
  //> P: Schema field or clause.
  error       String?
  //> P: Schema field or clause.
  createdAt   DateTime   @default(now())
  //> P: Schema field or clause.
  updatedAt   DateTime   @updatedAt

  //> P: Schema field or clause.
  agent     Agent      @relation(fields: [agentKey], references: [key], onDelete: Cascade)
  //> P: Schema field or clause.
  createdBy User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  //> P: Schema field or clause.
  thread    ChatThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)
  //> P: Schema field or clause.
  promptPackageInvariant TaskPromptPackageInvariant?

  //> P: Prisma attribute.
  @@index([agentKey, status, createdAt])
  //> P: Prisma attribute.
  @@index([status, nextAttemptAt, createdAt])
  //> P: Prisma attribute.
  @@index([issueNumber])
//> P: Block delimiter.
}

//> P: Data model definition.
model TaskPromptPackageInvariant {
  //> P: Schema field or clause.
  id             String   @id @default(cuid())
  //> P: Schema field or clause.
  taskId         String   @unique
  //> P: Schema field or clause.
  sourceKind     String
  //> P: Schema field or clause.
  sourceRef      String?
  //> P: Schema field or clause.
  issueNumber    Int?
  //> P: Schema field or clause.
  snapshotHash   String
  //> P: Schema field or clause.
  promptText     String
  //> P: Schema field or clause.
  packageBody    String?
  //> P: Schema field or clause.
  packageSections Json?
  //> P: Schema field or clause.
  payloadSnapshot Json?
  //> P: Schema field or clause.
  createdAt      DateTime @default(now())

  //> P: Schema field or clause.
  task AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  //> P: Prisma attribute.
  @@index([issueNumber, createdAt])
  //> P: Prisma attribute.
  @@index([sourceKind, createdAt])
  //> P: Prisma attribute.
  @@index([createdAt])
//> P: Block delimiter.
}

//> P: Data model definition.
model OrchestratorLease {
  //> P: Schema field or clause.
  id              String   @id
  //> P: Schema field or clause.
  ownerId         String?
  //> P: Schema field or clause.
  ownerHost       String?
  //> P: Schema field or clause.
  ownerPid        Int?
  //> P: Schema field or clause.
