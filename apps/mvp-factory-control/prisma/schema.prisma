  //> P: Schema field or clause.
  reason     String
  //> P: Schema field or clause.
  metadata   Json?
  //> P: Schema field or clause.
  createdAt  DateTime @default(now())

  //> P: Prisma attribute.
  @@index([entityType, entityId, createdAt])
  //> P: Prisma attribute.
  @@index([actorRole, action, createdAt])
  //> P: Prisma attribute.
