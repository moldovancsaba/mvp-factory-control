  DONE
  //> P: Schema field or clause.
  FAILED
  //> P: Schema field or clause.
  CANCELED
  //> P: Schema field or clause.
  MANUAL_REQUIRED
  //> P: Schema field or clause.
  DEAD_LETTER
//> P: Block delimiter.
}

//> P: Enum definition.
enum MemoryScope {
  //> P: Schema field or clause.
  GLOBAL
  //> P: Schema field or clause.
  APP
  //> P: Schema field or clause.
  USER
  //> P: Schema field or clause.
  APP_USER
  //> P: Schema field or clause.
