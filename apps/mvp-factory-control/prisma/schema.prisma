  //> P: Schema field or clause.
  snapshotHash          String
  //> P: Schema field or clause.
  handoverRef           String?
  //> P: Schema field or clause.
  handoverPackageRef    String?
  //> P: Schema field or clause.
  continuationPromptRef String?
  //> P: Schema field or clause.
  continuityNote        String?
  //> P: Schema field or clause.
  payloadSnapshot       Json?
  //> P: Schema field or clause.
  createdById           String?
  //> P: Schema field or clause.
