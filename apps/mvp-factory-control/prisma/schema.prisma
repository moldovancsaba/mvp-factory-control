  //> P: Schema field or clause.
  lastHeartbeatAt DateTime?
  //> P: Schema field or clause.
  heartbeatCount  Int      @default(0)
  //> P: Schema field or clause.
  acquiredAt      DateTime?
  //> P: Schema field or clause.
  createdAt       DateTime @default(now())
  //> P: Schema field or clause.
  updatedAt       DateTime @updatedAt

  //> P: Schema field or clause.
  audits OrchestratorLeaseAudit[]

  //> P: Prisma attribute.
  @@index([ownerId])
  //> P: Prisma attribute.
  @@index([expiresAt])
