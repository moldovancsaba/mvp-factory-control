// Prisma schema for the internal control app: agents, tasks, chat, orchestrator lease, alpha context,
// memory platform, audits, NextAuth tables. PostgreSQL via DATABASE_URL. Migrations under prisma/migrations/.
//> P: Prisma config block header.
generator client {
  //> P: Schema field or clause.
  provider = "prisma-client-js"
//> P: Block delimiter.
}

//> P: Prisma config block header.
datasource db {
  //> P: Schema field or clause.
  provider = "postgresql"
  //> P: Schema field or clause.
  url      = env("DATABASE_URL")
//> P: Block delimiter.
}

//> P: Enum definition.
enum AgentRuntime {
  //> P: Schema field or clause.
  LOCAL
  //> P: Schema field or clause.
  CLOUD
  //> P: Schema field or clause.
  MANUAL
//> P: Block delimiter.
}

//> P: Enum definition.
enum AgentReadiness {
  //> P: Schema field or clause.
  NOT_READY
  //> P: Schema field or clause.
  READY
  //> P: Schema field or clause.
  PAUSED
//> P: Block delimiter.
}

//> P: Enum definition.
enum AgentControlRole {
  //> P: Schema field or clause.
  ALPHA
  //> P: Schema field or clause.
  BETA
//> P: Block delimiter.
}

//> P: Enum definition.
enum AlphaContextStatus {
  //> P: Schema field or clause.
  OPEN
  //> P: Schema field or clause.
  ACTIVE
  //> P: Schema field or clause.
  TRANSFERRED
  //> P: Schema field or clause.
  CLOSED
//> P: Block delimiter.
}

//> P: Enum definition.
enum AlphaContextPackageSnapshotKind {
  //> P: Schema field or clause.
  ACTIVATED
  //> P: Schema field or clause.
  HANDOVER_PACKAGE
  //> P: Schema field or clause.
  TRANSFER_OUT
  //> P: Schema field or clause.
  TRANSFER_IN
  //> P: Schema field or clause.
  CLOSED
//> P: Block delimiter.
}

//> P: Enum definition.
enum ThreadKind {
  //> P: Schema field or clause.
  GLOBAL
  //> P: Schema field or clause.
  ISSUE
  //> P: Schema field or clause.
  PRODUCT
//> P: Block delimiter.
}

//> P: Enum definition.
enum MessageAuthorType {
  //> P: Schema field or clause.
  HUMAN
  //> P: Schema field or clause.
  AGENT
