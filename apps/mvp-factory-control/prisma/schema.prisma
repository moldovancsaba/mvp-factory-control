//> P: Block delimiter.
}

//> P: Enum definition.
enum MemoryLifecycleState {
  //> P: Schema field or clause.
  DRAFT
  //> P: Schema field or clause.
  SYSTEM_PROPOSED
  //> P: Schema field or clause.
  HUMAN_APPROVED
  //> P: Schema field or clause.
  SUPERSEDED
