# App — must match the URL you use in the browser (scheme + host + port).
# Local Next dev (pnpm dev) defaults to http://localhost:3007 unless you terminate TLS in front.
NEXTAUTH_URL=http://localhost:3007
NEXTAUTH_SECRET=change-me-please

# GitHub OAuth (login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Database (docker compose)
DATABASE_URL=postgresql://mvp_factory_control:mvp_factory_control@localhost:3579/mvp_factory_control?schema=public

# GitHub GraphQL token (service token for board reads/writes)
# Needs access to read/write ProjectsV2 and read repo issues.
MVP_FACTORY_CONTROL_GITHUB_TOKEN=
MVP_FACTORY_CONTROL_GITHUB_PROJECT_OWNER=moldovancsaba
MVP_FACTORY_CONTROL_GITHUB_PROJECT_NUMBER=1
MVP_FACTORY_CONTROL_TASK_REPO_OWNER=moldovancsaba
MVP_FACTORY_CONTROL_TASK_REPO_NAME=mvp-factory-control
MVP_FACTORY_CONTROL_DASHBOARD_PRODUCT=mvp-factory-control

# Optional: local worker settings (task runner)
MVP_FACTORY_CONTROL_WORKER_AGENT_KEY=Gwen
MVP_FACTORY_CONTROL_WORKER_POLL_MS=1200
MVP_FACTORY_CONTROL_WORKER_RUNTIME=LOCAL
MVP_FACTORY_CONTROL_WORKER_MODEL=deepseek-r1:1.5b
MVP_FACTORY_CONTROL_WORKER_HOST=
# Ollama via MVP HTTPS gateway (TLS). Trust the loopback cert (Control.app / bootstrap create it):
# export NODE_EXTRA_CA_CERTS=/path/to/mvp-factory-control/.mvp-factory-control/tls/localhost-cert.pem
# pnpm dev runs scripts/dev-with-gateway-ca.sh which sets NODE_EXTRA_CA_CERTS from the repo root.
MVP_HTTPS_GATEWAY_PORT=3443
OLLAMA_BASE_URL=https://127.0.0.1:3443/ollama
OLLAMA_MODEL=deepseek-r1:1.5b

# Optional: OpenAI runtime for cloud agents (for example Chappie)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-nano
OPENAI_API_KEY=

# Optional: local-only dev login (avoid OAuth while bootstrapping)
MVP_FACTORY_CONTROL_DEV_LOGIN_EMAIL=
MVP_FACTORY_CONTROL_DEV_LOGIN_PASSWORD=

# Optional: RBAC baseline for privileged MVP Factory Control actions.
# Role resolution order: ADMIN -> OPERATOR -> VIEWER -> CLIENT.
# If email is not listed in any role list, MVP_FACTORY_CONTROL_RBAC_DEFAULT_ROLE is applied.
MVP_FACTORY_CONTROL_RBAC_ADMIN_EMAILS=
MVP_FACTORY_CONTROL_RBAC_OPERATOR_EMAILS=
MVP_FACTORY_CONTROL_RBAC_VIEWER_EMAILS=
MVP_FACTORY_CONTROL_RBAC_CLIENT_EMAILS=
MVP_FACTORY_CONTROL_RBAC_DEFAULT_ROLE=OPERATOR
